local function hasTool(name)
	if plr.Character and plr.Character:FindFirstChild(name) then return true end
	if plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild(name) then return true end
	return false
end

local function giveFakeTool(def)
	if hasTool(def.name) then
		if showNotifs then notify_lib.notify("Write A Letter Script", "Already have " .. def.name, 1.5) end
		return
	end

	local tool = Instance.new("Tool")
	tool.Name = def.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = def.name

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 1)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Anchored = false
	handle.Parent = tool

	local toolModule = nil
	pcall(function() toolModule = rs.ToolModules:FindFirstChild(def.name) end)

	if toolModule then
		for _, child in ipairs(toolModule:GetChildren()) do
			if child:IsA("Animation") then
				child:Clone().Parent = tool
			end
		end
	end

	local equipTrack = nil
	local actionTrack = nil

	tool.Equipped:Connect(function()
		local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if not animator then return end
		if def.equip then
			local anim = tool:FindFirstChild(def.equip)
			if anim and anim:IsA("Animation") then
				equipTrack = animator:LoadAnimation(anim)
				equipTrack.Looped = true
				equipTrack:Play()
			end
		end
	end)

	tool.Unequipped:Connect(function()
		if equipTrack then equipTrack:Stop() equipTrack = nil end
		if actionTrack then actionTrack:Stop() actionTrack = nil end
	end)

	if def.action then
		tool.Activated:Connect(function()
			local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if not animator then return end
			local anim = tool:FindFirstChild(def.action)
			if anim and anim:IsA("Animation") then
				if actionTrack then actionTrack:Stop() end
				actionTrack = animator:LoadAnimation(anim)
				actionTrack:Play()
			end
		end)
	end

	tool.Parent = plr:FindFirstChild("Backpack")
	toolOwned[def.name] = true
	if showNotifs then notify_lib.notify("Write A Letter Script", "Gave " .. def.name, 1.5) end
end

