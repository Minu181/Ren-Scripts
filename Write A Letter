					if data and data.data then
						for _, s in ipairs(data.data) do
							table.insert(allServers, s)
						end
						nextPageCursor = data.nextPageCursor
						renderServers()
					end
				end
				isLoading = false
			end)
		end)
	end

	local total = 0
	for _ in ipairs(allServers) do total = total + 1 end
	svListFrame.CanvasSize = UDim2.new(0, 0, 0, svListLayout.AbsoluteContentSize.Y + 12)
