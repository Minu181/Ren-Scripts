	local sLayout = Instance.new("UIListLayout")
	sLayout.SortOrder = Enum.SortOrder.LayoutOrder
	sLayout.Padding = UDim.new(0, 10)
	sLayout.Parent = scroll
	utils.pad(scroll, 15, 15, 15, 15)

	sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y + 30)
	end)

	local function select_tab()
		if self.cur_tab == name then return end
		for _, t in ipairs(self.tabs) do
			t.scroll.Visible = false
			ts:Create(t.btn, fastTween, {TextColor3 = theme.txtMuted, BackgroundTransparency = 1}):Play()
		end
		self.cur_tab = name
		scroll.Visible = true
		ts:Create(btn, fastTween, {TextColor3 = theme.txtMain, BackgroundTransparency = 0}):Play()
	end

	btn.MouseButton1Click:Connect(select_tab)

	table.insert(self.tabs, {name = name, btn = btn, scroll = scroll})
	if idx == 1 then select_tab() end

	return scroll
end

