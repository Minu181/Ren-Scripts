	local bp = plr:FindFirstChild("Backpack")
	if not bp then return end
	local hasFish = false
	for _, child in ipairs(bp:GetChildren()) do
		if child:IsA("Tool") then
			local n = child.Name:lower()
			if n ~= "fishing rod" and n ~= "rod" and n ~= "caña" then
				hasFish = true
				break
			end
		end
	end
	if not hasFish then
		fishCount = 0
		fishNeedsPause = false
		return
	end

	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	fishOriginalCF = root.CFrame
	fishState = "Selling fish..."
	fishUpdateUI()

	root.CFrame = CFrame.new(-950.81, 15.60, 0.22)
	task.wait(0.5)

	pcall(function()
		local prompt = workspace.Pond.Sell.PromptPart.SellAllPrompt
		if prompt and fireproximityprompt then
			fireproximityprompt(prompt)
		end
	end)
	task.wait(1)

	if fishOriginalCF then
		root.CFrame = fishOriginalCF
		fishOriginalCF = nil
	end
	fishCount = 0
	fishNeedsPause = false
end

local function fishStart()
	if fishMainThread then return end
	fishRunning = true
	fishMainThread = task.spawn(function()
		while doAutoFish do
			fishCleanup()
			fishReleaseAllMovement()
			task.wait(0.5)

			local c = plr.Character
			if c and not c:FindFirstChild("Humanoid") then
				task.wait(1)
			end

			fishRod = fishFindRod()
			if not fishRod then
				fishState = "Equipping rod..."
				fishUpdateUI()
				task.wait(1)
				continue
			end

			fishUnequipTools()
			task.wait(0.5)
			fishEquipTool(fishRod)
			task.wait(0.5)

			local ce = fishRod:FindFirstChild("ClassEvent")
			if not ce then
				ce = fishRod:WaitForChild("ClassEvent", 5)
			end

			if ce then
				local caughtFish = false
				fishConn = ce.OnClientEvent:Connect(function(ev)
					if not doAutoFish then return end
					if ev.type == "BITE" then
						fishState = "Fish bite! Hooking..."
						fishUpdateUI()
						task.delay(0.15, function()
							if fishRod and fishRod.Parent then fishRod:Activate() end
						end)
					elseif ev.type == "MINIGAME" then
						fishState = "Waiting Minigame..."
						fishUpdateUI()
						task.delay(0.1, function() fishStartMinigame(ev.seed) end)
					elseif ev.type == "LAND" then
						fishState = "You Caught: " .. (ev.name or ev.fishName or "Fish") .. "!"
						if showNotifs then
							notify_lib.notify("Write A Letter Script", "You Caught: " .. (ev.name or ev.fishName or "Fish") .. "!", 2)
						end
						fishCount = fishCount + 1
						if doAutoSell and fishCount >= fishMaxCount then
							fishNeedsPause = true
						end
						fishUpdateUI()
						fishCleanup()
						caughtFish = true
					elseif ev.type == "BITE_ESCAPE" then
						fishState = "Fish got away..."
						fishUpdateUI()
						fishCleanup()
					elseif ev.type == "RESET" then
						fishState = "Resetting..."
						fishUpdateUI()
						fishCleanup()
					end
				end)

				fishState = "Casting..."
				fishUpdateUI()
				fishCastRod(fishRod)
				task.wait(0.5)
				fishState = "Waiting for fish..."
				fishUpdateUI()

				local startTime = tick()
				while doAutoFish and (tick() - startTime) < 90 and not caughtFish do
					task.wait(0.5)
				end

				if fishConn then fishConn:Disconnect(); fishConn = nil end
				fishCleanup()
				if caughtFish then
					fishState = "Preparing..."
					fishUpdateUI()
				end
				if doAutoSell and fishNeedsPause then
					fishNeedsPause = false
					sellAllFish()
					fishUpdateUI()
					task.wait(0.5)
				end
				task.wait(0.5)
			else
				fishState = "Fallback mode..."
				fishUpdateUI()
				fishCastRod(fishRod)
				task.wait(3)
			end
		end
		fishState = "Idle"
		fishUpdateUI()
	end)
end

local function fishStop()
	fishRunning = false
	fishProcessing = false
	fishState = "Idle"
	fishCleanup()
	if fishMainThread then
		task.cancel(fishMainThread)
		fishMainThread = nil
	end
	fishUpdateUI()
end

local function getTarget()
	if not curTarget then return nil end
	local t = Players:FindFirstChild(curTarget)
	if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
		local h = t.Character:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 then
			return t
		end
	end
	return nil
end

local function getClosest()
	local best, dist = nil, math.huge
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return nil end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= plr and p.Character then
			local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
			local h = p.Character:FindFirstChildOfClass("Humanoid")
			if tRoot and h and h.Health > 0 then
				local d = (tRoot.Position - root.Position).Magnitude
				if d < dist then best, dist = p, d end
			end
		end
	end
	return best
end

local function getNames()
	local names = {"None"}
	local counts = {}

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= plr then
			local d = p.DisplayName
			counts[d] = (counts[d] or 0) + 1
		end
	end

	disp_to_name = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= plr then
			local d = p.DisplayName
			if counts[d] > 1 then
				d = d .. " (" .. p.Name .. ")"
			end
			table.insert(names, d)
			disp_to_name[d] = p.Name
		end
	end

	return names
end

local function getBall()
	local c = plr.Character
	if c and c:FindFirstChild("Snowball") then
		return c.Snowball
	end

	local bp = plr:FindFirstChild("Backpack")
	if bp and bp:FindFirstChild("Snowball") then
		local h = c:FindFirstChildOfClass("Humanoid")
		if h then
			h:EquipTool(bp.Snowball)
			return c:WaitForChild("Snowball", 1)
		end
	end
	return nil
end

local function doInteract()
	if not fireproximityprompt then return false end
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			local part = d.Parent
			if root and part and part:IsA("BasePart") then
				local dist = (root.Position - part.Position).Magnitude
				if dist <= d.MaxActivationDistance + 5 then
					fireproximityprompt(d)
					vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
					task.wait(0.05)
					vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
					return true
				end
			end
		end
	end
	return false
end

local function runRefill()
	if tick() - lastRefill < 2 then return end
	if isRefilling or not plr.Character then return end
	local root = plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	
	isRefilling = true
	lastRefill = tick()
	
	pcall(function()
		local spot = REFILL_SPOTS[math.random(#REFILL_SPOTS)]

		local prompt = nil
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				local part = d.Parent
				if part and part:IsA("BasePart") then
					if (part.Position - spot.Position).Magnitude < 10 then
						prompt = d
						break
					end
				end
			end
		end

		local oldCF = root.CFrame
		root.CFrame = spot
		task.wait(0.2)

		local tries = 0
		while not getBall() and tries < 30 do
			if not uis.TouchEnabled then
				root.CFrame = spot
				if prompt then
					pcall(fireproximityprompt, prompt)
				end
				vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
				task.wait(0.05)
				vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
			else
				root.CFrame = spot
			end
			task.wait(0.1)
			tries = tries + 1
		end

		root.CFrame = oldCF
		task.wait(0.15)
	end)
	
	isRefilling = false
	lastRefillEnd = tick()
end

local function stopTarget()
	if targetLoop then
		targetLoop:Disconnect()
		targetLoop = nil
	end
end

local function startTarget()
	stopTarget()
	if not plr.Character then return end
	local root = plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	origPos = root.CFrame
	phaseStart = tick()
	targetLoop = run_svc.Stepped:Connect(function()
		if not doAutoTarget then
			stopTarget()
			return
		end
		if isRefilling then return end
		local mRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not mRoot then return end

		if targetPhase == "tracking" then
			local t = getTarget()
			if not t then
				if origPos then mRoot.CFrame = origPos end
				return
			end
			local tRoot = t.Character:FindFirstChild("HumanoidRootPart")
			if not tRoot then return end
			mRoot.CFrame = CFrame.new(tRoot.Position - tRoot.CFrame.LookVector * 1)
			if tick() - phaseStart < 0.1 then return end
			local ball = getBall()
			if ball and ball:FindFirstChild("ClassEvent") then
				local tHead = t.Character:FindFirstChild("Head")
				local hitPos = tHead and tHead.Position or tRoot.Position
				ball.ClassEvent:FireServer({ type = "THROW", hit = hitPos })
				if getBall() then
					phaseStart = tick()
				else
					mRoot.CFrame = origPos
					targetPhase = "retreating"
				end
			elseif not isRefilling then
				task.spawn(runRefill)
			end
		elseif targetPhase == "retreating" then
			if origPos then mRoot.CFrame = origPos end
			if tick() - lastRefill >= 2 then
				targetPhase = "refilling"
			end
		elseif targetPhase == "refilling" then
			if not getBall() then
				task.spawn(runRefill)
			else
				phaseStart = tick()
				targetPhase = "tracking"
			end
		end
	end)
end

