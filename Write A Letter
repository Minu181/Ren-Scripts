	end
end

local function fishGetMinigameState()
	local default = {
		moveDirection = Vector3.zero,
		isInSuccessZone = false,
		targetDistance = 1,
		offsetX = 0,
		offsetY = 0,
	}
	local pg = plr:FindFirstChild("PlayerGui")
	if not pg then return default end
	local mg = pg:FindFirstChild("FishMinigame")
	if not mg then return default end
	local outer = mg:FindFirstChild("OuterRing")
	if not outer then return default end
	local tgt = outer:FindFirstChild("Target")
	if not tgt then return default end
	local inner = outer:FindFirstChild("InnerRing")
	local tp = tgt.Position
	local ox = tp.X.Scale - 0.5
	local oy = tp.Y.Scale - 0.5
	local dist = math.sqrt(ox * ox + oy * oy)
	local threshold = 0.3
	if inner then
		local ok, sz = pcall(function() return inner.Size end)
		if ok and sz then threshold = sz.X.Scale / 2 end
	end
	return {
		moveDirection = Vector3.new(ox, oy, 0),
		isInSuccessZone = dist <= threshold,
		targetDistance = dist,
		offsetX = ox,
		offsetY = oy,
	}
end

local function fishHandleMovement(ox, oy)
	local deadzone = 0.05
	if math.sqrt(ox * ox + oy * oy) < deadzone then
		fishReleaseAllMovement()
		return
	end
	local needW = oy > deadzone
	local needS = oy < -deadzone
	local needA = ox > deadzone
	local needD = ox < -deadzone
	if needW and not fishMovementState.W then
		fishSendKey(Enum.KeyCode.W, true); fishMovementState.W = true
	elseif not needW and fishMovementState.W then
		fishSendKey(Enum.KeyCode.W, false); fishMovementState.W = false
	end
	if needS and not fishMovementState.S then
		fishSendKey(Enum.KeyCode.S, true); fishMovementState.S = true
	elseif not needS and fishMovementState.S then
		fishSendKey(Enum.KeyCode.S, false); fishMovementState.S = false
	end
	if needA and not fishMovementState.A then
		fishSendKey(Enum.KeyCode.A, true); fishMovementState.A = true
	elseif not needA and fishMovementState.A then
		fishSendKey(Enum.KeyCode.A, false); fishMovementState.A = false
	end
	if needD and not fishMovementState.D then
		fishSendKey(Enum.KeyCode.D, true); fishMovementState.D = true
	elseif not needD and fishMovementState.D then
		fishSendKey(Enum.KeyCode.D, false); fishMovementState.D = false
	end
end

local function fishStartMinigame(seed)
	if fishProcessing then return end
	fishProcessing = true
	fishState = "Playing Minigame..."
	fishUpdateUI()
	fishMinigameThread = task.spawn(function()
		local lastClick = 0
		while fishProcessing and doAutoFish do
			local st = fishGetMinigameState()
			fishHandleMovement(st.offsetX, st.offsetY)
			local now = tick()
			if st.isInSuccessZone and 0.12 <= (now - lastClick) then
				if fishRod and fishRod.Parent then
					fishRod:Activate()
					lastClick = now
				end
			end
			task.wait(0.03)
		end
		fishReleaseAllMovement()
	end)
	local startT = tick()
	fishRenderConn = run_svc.RenderStepped:Connect(function()
		if tick() - startT < 1 then return end
		local pg = plr:FindFirstChild("PlayerGui")
		if pg and not pg:FindFirstChild("FishMinigame") then
			fishCleanup()
		end
	end)
end

