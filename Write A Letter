	notif_container.Parent = ui_mount

	notif_container:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		updateNotifs()
	end)

	return notif_container
end

function getNotifHeight()
	local container = notif_container
	if not container then return 600 end
	local absY = container.AbsoluteSize.Y
	if absY > 0 then return absY end
	local parent = notif_container.Parent
	if parent then
		local parentY = parent.AbsoluteSize.Y
		if parentY > 0 then return parentY - 40 end
	end
	return 600
end

function updateNotifs()
	local h, gap = 65, 10
	local container = getContainer()
	local absY = getNotifHeight()
	local startY = absY - 20
	for i, n in ipairs(notifs_q) do
		local targetY = startY - ((h + gap) * (#notifs_q - i + 1))
		ts:Create(n.Frame, mainTween, {Position = UDim2.new(0, 0, 0, targetY)}):Play()
	end
end

