function ui_lib:toggle_min()
	self.minimized = not self.minimized
	local h = self.minimized and 45 or self.orig_size.Y.Offset
	local target_size = UDim2.new(self.orig_size.X.Scale, self.orig_size.X.Offset, 0, h)

	if self.minimized then
		self.body_frame.Visible = false
		self.tabs_bar.Visible = false
	else
		task.delay(0.1, function()
			if not self.minimized then
				self.body_frame.Visible = true
				self.tabs_bar.Visible = true
			end
		end)
	end
	if self.StatusBar then
		self.StatusBar.Visible = not self.minimized
	end
	ts:Create(self.shadow_frame, mainTween, {Size = target_size}):Play()
end

function ui_lib:close()
	notify_lib.notify("Write A Letter Script", "Closing...", 2.5)
	_G.__LUAU_SHUTTING_DOWN__ = true
	for _, t in ipairs(self.toggles) do
		t(false)
	end
	_G.__LUAU_SHUTTING_DOWN__ = nil

	for _, c in ipairs(self.conns) do
		if typeof(c) == "RBXScriptConnection" then
			c:Disconnect()
		end
	end
	for i = #self.conns, 1, -1 do self.conns[i] = nil end
	self.conns = {}

	local fade = ts:Create(self.main_frame, fastTween, {GroupTransparency = 1})
	local shrink = ts:Create(self.shadow_frame, fastTween, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})

	fade:Play()
	shrink:Play()
	shrink.Completed:Connect(function()
		self.shadow_frame:Destroy()
		_G.__LUAU_SNOWBALL_RUNNING__ = nil
	end)
end

