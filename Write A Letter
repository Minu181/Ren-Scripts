local accum = 0
table.insert(lib.conns, run_svc.Heartbeat:Connect(function(dt)
	accum = accum + dt
	if accum >= 0.1 then
		accum = 0
		
		if not plr.Character then return end
		local root = plr.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local hum = plr.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			if doRunAnywhere then
				pcall(function()
					local status = plr.Character:FindFirstChild("Status")
					if status then
						local fre = status:FindFirstChild("Force_RunEnabled")
						local frd = status:FindFirstChild("Force_RunDisabled")
						if fre then fre.Value = true end
						if frd then frd.Value = false end
					end
				end)
				pcall(function()
					local mods = plr.Character:FindFirstChild("Status") and plr.Character.Status:FindFirstChild("WalkspeedModifiers")
					if mods then
						for _, v in ipairs(mods:GetChildren()) do
							if v:IsA("NumberValue") and v.Name == "SnowstormSlow" then
								v:Destroy()
							end
						end
					end
				end)
			end
		end

		if doAutoRefill and not isRefilling and tick() - lastThrow >= 1 then
			local hasBall = (plr.Character and plr.Character:FindFirstChild("Snowball"))
				or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Snowball"))
			if not hasBall then
				task.spawn(runRefill)
			end
		end

		if doAutoShoot and not isRefilling and tick() - lastShoot >= 0.1 then
			if tick() - lastRefillEnd < 0.1 then return end
			local t = shootClosest and getClosest() or getTarget()
			if t and t.Character then
				local ball = getBall()
				if ball and ball:FindFirstChild("ClassEvent") then
					local tRoot = t.Character:FindFirstChild("HumanoidRootPart")
					local tHead = t.Character:FindFirstChild("Head")
					if tRoot then
						local hitPos = tHead and tHead.Position or tRoot.Position
						pcall(function()
							ball.ClassEvent:FireServer({
								type = "THROW",
								hit = hitPos
							})
						end)
						lastShoot = tick()
						if doAutoRefill then
							local hasBall = (plr.Character and plr.Character:FindFirstChild("Snowball"))
								or (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Snowball"))
							if not hasBall then
								task.spawn(runRefill)
							end
						end
					end
				end
			end
		end
	end
end))

