		local val = (label and tonumber(label.Text)) or 0
		if not neighborCache[cell] then
			neighborCache[cell] = getNeighbors(cell, allParts)
		end
		local hidden, mines = {}, 0
		local nbs = neighborCache[cell]
		for j = 1, #nbs do
			local n = nbs[j]
			if not n or not n.Parent then continue end
			local nOpen = n.Transparency > 0.5 or (n.Color.R > 0.7 and n.Color.G > 0.7 and n.Color.B < 0.6) or n:FindFirstChild("NumberGui")
			if not nOpen then
				if n.Color == _Color3(0,0,0) then mines = mines + 1 else hidden[#hidden + 1] = n end
			end
		end
		if #hidden > 0 or val == 0 then
			local set = {}
			for j = 1, #hidden do set[hidden[j]] = true end
			local entry = {obj = cell, eVal = val - mines, hidden = hidden, set = set}
			numberData[#numberData + 1] = entry
			for j = 1, #hidden do
				local h = hidden[j]
				if not cellToData[h] then cellToData[h] = {} end
				cellToData[h][#cellToData[h] + 1] = #numberData
			end
		end
	end
