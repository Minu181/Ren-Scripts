function utils.draggable(dragFrame, dragHandle, garbage)
	local is_dragging = false
	local drag_input
	local drag_start
	local start_pos
	table.insert(garbage, dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			is_dragging = true
			drag_start = input.Position
			start_pos = dragFrame.Position
			local conn; conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					is_dragging = false
					if conn then conn:Disconnect() end
				end
			end)
		end
	end))
	table.insert(garbage, dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			drag_input = input
		end
	end))
	table.insert(garbage, uis.InputChanged:Connect(function(input)
		if is_dragging and input == drag_input then
			local delta = input.Position - drag_start
			dragFrame.Position = UDim2.new(
				start_pos.X.Scale,
				start_pos.X.Offset + delta.X,
				start_pos.Y.Scale,
				start_pos.Y.Offset + delta.Y
			)
		end
	end))
end
