function ui_lib:close()
	isAutoSolving = false
	isLegitActive = false
	stopCurrentExecution = false
	isWaitingForRound = false
	isGuessing = false
	neighborCache = {}
	flaggedDebounce = {}
	notify_lib.notify("Auto Solver V2", "Closing...", 2.5)
	_G.__LUAU_SHUTTING_DOWN__ = true
	for _, t in ipairs(self.toggles) do
		t(false)
	end
	_G.__LUAU_SHUTTING_DOWN__ = nil
	for _, c in ipairs(self.conns) do
		if typeof(c) == "RBXScriptConnection" then
			c:Disconnect()
		end
	end
	for i = #self.conns, 1, -1 do self.conns[i] = nil end
	self.conns = {}
	local fade = ts:Create(self.main_frame, fastTween, {GroupTransparency = 1})
	local shrink = ts:Create(self.shadow_frame, fastTween, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1})
	fade:Play()
	shrink:Play()
	shrink.Completed:Connect(function()
		self.shadow_frame:Destroy()
