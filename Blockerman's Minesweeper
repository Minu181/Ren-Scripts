	val_disp.TextXAlignment = Enum.TextXAlignment.Right
	val_disp.Parent = cont
	local track = Instance.new("TextButton")
	track.Size = UDim2.new(1, 0, 0, 6)
	track.Position = UDim2.new(0, 0, 1, -10)
	track.BackgroundColor3 = theme.border
	track.Text = ""
	track.AutoButtonColor = false
	track.Parent = cont
	utils.corner(track, 3)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = theme.accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	utils.corner(fill, 3)
	local is_drag = false
	local function set_value(v)
		local clamped = math.max(min, math.min(max, v))
		local snapped = min + (math.floor((clamped - min) / step + 0.5) * step)
		local prec = 0
		local temp = step
		while temp < 1 and prec < 10 do
			temp = temp * 10
			prec = prec + 1
		end
		if prec > 0 then
			local mult = 10 ^ prec
			snapped = math.floor(snapped * mult + 0.5) / mult
		end
		snapped = math.min(max, math.max(min, snapped))
		self.flags[flag] = snapped
		val_disp.Text = tostring(snapped)
		local pct = (snapped - min) / (max - min)
		ts:Create(fill, fastTween, {Size = UDim2.new(pct, 0, 1, 0)}):Play()
		cb(snapped)
	end
	local function upd_slider(input)
		local abs_w = track.AbsoluteSize.X
		if abs_w == 0 then return end
		local rel_x = input.Position.X - track.AbsolutePosition.X
		local pct = math.clamp(rel_x / abs_w, 0, 1)
		local mapped = min + (math.floor((pct * (max - min)) / step + 0.5) * step)
		set_value(mapped)
	end
	self.setters = self.setters or {}
	self.setters[flag] = set_value
	table.insert(self.conns, track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			is_drag = true
			upd_slider(input)
		end
	end))
	table.insert(self.conns, uis.InputChanged:Connect(function(input)
		if is_drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			upd_slider(input)
		end
	end))
	table.insert(self.conns, uis.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			is_drag = false
		end
	end))
	return cont
end
