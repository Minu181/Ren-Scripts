end
local function bruteForceSolve(data)
	local hiddenList, cellToIdx = {}, {}
	for i = 1, #data do
		local d = data[i]
		local hlist = d.hidden
		for j = 1, #hlist do
			local h = hlist[j]
			if not cellToIdx[h] then
				cellToIdx[h] = #hiddenList + 1
				hiddenList[#hiddenList + 1] = h
			end
		end
	end
	if #hiddenList == 0 then return nil end
	local constraints = {}
	for i = 1, #data do
		local d = data[i]
		if #d.hidden == 0 then continue end
		local indices = {}
		local hlist = d.hidden
		for j = 1, #hlist do indices[#indices + 1] = cellToIdx[hlist[j]] end
		constraints[#constraints + 1] = {indices = indices, expected = d.eVal}
	end
	local cellToConIdx = {}
	for ci = 1, #constraints do
		local c = constraints[ci]
		local clist = c.indices
		for j = 1, #clist do
			local gi = clist[j]
			if not cellToConIdx[gi] then cellToConIdx[gi] = {} end
			cellToConIdx[gi][#cellToConIdx[gi] + 1] = ci
		end
	end
	local totalEV, totalHiddenInC = 0, 0
	for i = 1, #data do
		local d = data[i]
		totalEV = totalEV + d.eVal
		totalHiddenInC = totalHiddenInC + #d.hidden
	end
	local bgDensity = (totalHiddenInC > 0) and (totalEV / totalHiddenInC) or 0.2
	local adj = {}
	for i = 1, #hiddenList do adj[i] = {} end
	for i = 1, #constraints do
		local c = constraints[i]
		for a = 1, #c.indices do
			for b = a + 1, #c.indices do
				local ia, ib = c.indices[a], c.indices[b]
				adj[ia][ib] = true; adj[ib][ia] = true
			end
		end
	end
	local visited, components, compCons = {}, {}, {}
	for i = 1, #hiddenList do
		if visited[i] then continue end
		local comp, queue = {}, {i}
		local qhead = 1
		local consSet = {}
		visited[i] = true
		while qhead <= #queue do
			local cur = queue[qhead]; qhead = qhead + 1
			comp[#comp + 1] = cur
			local clist = cellToConIdx[cur]
			if clist then
				for j = 1, #clist do consSet[clist[j]] = true end
			end
			local k = _next(adj[cur], nil)
			while k do
				if not visited[k] then visited[k] = true; queue[#queue + 1] = k end
				k = _next(adj[cur], k)
			end
		end
		components[#components + 1] = comp
		local consList = {}
		local k = _next(consSet, nil)
		while k do
			consList[#consList + 1] = k
			k = _next(consSet, k)
		end
		compCons[#compCons + 1] = consList
	end
	local probs = {}
	for ci = 1, #components do
		local comp = components[ci]
		local solveStart = _clock()
		local n = #comp
		local globalToLocal = {}
		for li = 1, n do globalToLocal[comp[li]] = li end
		local localConstraints = {}
		local gciList = compCons[ci]
		for j = 1, #gciList do
			local c = constraints[gciList[j]]
			local loc = {}
			local ciList = c.indices
			for k = 1, #ciList do loc[#loc + 1] = globalToLocal[ciList[k]] end
			localConstraints[#localConstraints + 1] = {indices = loc, expected = c.expected}
		end
		if n > 35 or #localConstraints == 0 then
			local compEV, compHidden = 0, 0
			for j = 1, #localConstraints do
				local c = localConstraints[j]
				compEV = compEV + c.expected
				compHidden = compHidden + #c.indices
			end
			local compDensity = (compHidden > 0) and (compEV / compHidden) or bgDensity
			for j = 1, #comp do probs[comp[j]] = compDensity end
			continue
		end
		local localMines, localValid = {}, 0
		for li = 1, n do localMines[li] = 0 end
		local assign = {}
		for li = 1, n do assign[li] = false end
		local budgetExceeded, leafCount = false, 0
		local timeBudget = _mhuge
		if n > 20 then timeBudget = math.min(0.030, n * 0.0008) end
		local cellOrder = {}
		for li = 1, n do cellOrder[li] = li end
		local cellWeights = {}
		for li = 1, n do cellWeights[li] = 0 end
		for j = 1, #localConstraints do
			local c = localConstraints[j]
			local ciList = c.indices
			for k = 1, #ciList do cellWeights[ciList[k]] = cellWeights[ciList[k]] + 1 end
		end
		_tsort(cellOrder, function(a, b) return cellWeights[a] > cellWeights[b] end)
		local orderPos = {}
		for pos = 1, n do orderPos[cellOrder[pos]] = pos end
		local conMineCount = {}
		for ci = 1, #localConstraints do conMineCount[ci] = 0 end
		local cellToCons = {}
		for ci = 1, #localConstraints do
			local c = localConstraints[ci]
			local ciList = c.indices
			for j = 1, #ciList do
				local li = ciList[j]
				if not cellToCons[li] then cellToCons[li] = {} end
				cellToCons[li][#cellToCons[li] + 1] = ci
			end
		end
		local conAssigned = {}
		for ci = 1, #localConstraints do conAssigned[ci] = 0 end
		local function prune(depth)
			for ci = 1, #localConstraints do
				local c = localConstraints[ci]
				local unassignedCount = #c.indices - conAssigned[ci]
				if conMineCount[ci] > c.expected then return true end
				if conMineCount[ci] + unassignedCount < c.expected then return true end
			end
			return false
		end
		local function recurse(pos)
			if budgetExceeded then return end
			if pos > n then
				leafCount = leafCount + 1
				if leafCount % 4096 == 0 and timeBudget ~= _mhuge and _clock() - solveStart > timeBudget then
					budgetExceeded = true; return
				end
				localValid = localValid + 1
				for li = 1, n do if assign[li] then localMines[li] = localMines[li] + 1 end end
				return
			end
			local li = cellOrder[pos]
			assign[li] = false
			if not prune(pos) then recurse(pos + 1) end
			if budgetExceeded then return end
			assign[li] = true
			local cclist = cellToCons[li]
			if cclist then
				for j = 1, #cclist do
					local ci = cclist[j]
					conMineCount[ci] = conMineCount[ci] + 1
					conAssigned[ci] = conAssigned[ci] + 1
				end
			end
			if not prune(pos) then recurse(pos + 1) end
			if cclist then
				for j = 1, #cclist do
					local ci = cclist[j]
					conMineCount[ci] = conMineCount[ci] - 1
					conAssigned[ci] = conAssigned[ci] - 1
				end
			end
		end
		recurse(1)
		if localValid == 0 then
			local compEV, compHidden = 0, 0
			for j = 1, #localConstraints do
				local c = localConstraints[j]
				compEV = compEV + c.expected
				compHidden = compHidden + #c.indices
			end
			local compDensity = (compHidden > 0) and (compEV / compHidden) or bgDensity
			for j = 1, #comp do probs[comp[j]] = compDensity end
			continue
		end
		for li = 1, n do
			probs[comp[li]] = localMines[li] / localValid
		end
	end
	local alwaysSafe, alwaysMine, probabilities = {}, {}, {}
	for i = 1, #hiddenList do
		local cell = hiddenList[i]
		local p = probs[i]
		probabilities[cell] = p
		if p == 0 then alwaysSafe[#alwaysSafe + 1] = cell
		elseif p == 1 then alwaysMine[#alwaysMine + 1] = cell end
	end
	return alwaysSafe, alwaysMine, probabilities
end
local function estimateCascade(start, cellToData, data)
	local frontier = {start}
	local head = 1
	local opened = {[start] = true}
	local revealed = 0
	while head <= #frontier do
		local cell = frontier[head]; head = head + 1
		revealed = revealed + 1
		local entry = cellToData[cell]
		if entry then
			for j = 1, #entry do
				local d = data[entry[j]]
				if d.eVal == 0 then
					local hlist = d.hidden
					for k = 1, #hlist do
						local h = hlist[k]
						if not opened[h] and h.Color ~= _Color3(0,0,0) then
							opened[h] = true; frontier[#frontier + 1] = h
						end
					end
				end
			end
		end
	end
	return revealed
end
function mainLoop()
	if stopCurrentExecution then return end
	if (not isAutoSolving and not isLegitActive) or isWaitingForRound then return end
	if currentTab == "flag" and isLegitActive then
		if _clock() - lastCalcTime < calculateDelay then return end
	end
	lastCalcTime = _clock()
	local data, cellToData = getSolverData()
	if #data == 0 then return end
	local allSafe, allMines = {}, {}
	local madeDeduction = true
	local iterationLimit = 20
	local bfProbCache = nil
	while madeDeduction and iterationLimit > 0 do
		iterationLimit = iterationLimit - 1
		madeDeduction = false
		local mineQueue, safeQueue = {}, {}
		local constraintPairs = {}
		for i = 1, #data do constraintPairs[i] = {} end
		local k = _next(cellToData, nil)
		while k do
			local hlist = cellToData[k]
			for a = 1, #hlist do
				for b = a + 1, #hlist do
					constraintPairs[hlist[a]][hlist[b]] = true
					constraintPairs[hlist[b]][hlist[a]] = true
				end
			end
			k = _next(cellToData, k)
		end
		for i = 1, #data do
			local d1 = data[i]
			local s1 = d1.hidden
			local j = _next(constraintPairs[i], nil)
			while j do
				local d2 = data[j]
				local s2 = d2.hidden
				if #s2 > #s1 then
					local isSubset = true
					for _i = 1, #s1 do
						if not d2.set[s1[_i]] then isSubset = false; break end
					end
					if isSubset then
						local diffMines = d2.eVal - d1.eVal
						if diffMines == 0 then
							for _i = 1, #s2 do
								local x = s2[_i]
								if not d1.set[x] and (not x or not x.Parent) then
									
								elseif not d1.set[x] and (x.Transparency > 0.5 or (x.Color.R > 0.7 and x.Color.G > 0.7 and x.Color.B < 0.6) or x:FindFirstChild("NumberGui")) then
									
								elseif not d1.set[x] and x.Color ~= _Color3(0,0,0) then
									safeQueue[#safeQueue + 1] = x; madeDeduction = true
								end
							end
						elseif diffMines > 0 then
							local diffCount = 0
							local diffList = {}
							for _i = 1, #s2 do
								local x = s2[_i]
								if not d1.set[x] then diffCount = diffCount + 1; diffList[#diffList + 1] = x end
							end
							if diffMines == diffCount then
								for _i = 1, #diffList do
									local n = diffList[_i]
									if n.Color ~= _Color3(0,0,0) then
										mineQueue[#mineQueue + 1] = n; madeDeduction = true
									end
								end
							end
						end
					end
				end
				j = _next(constraintPairs[i], j)
			end
		end
		for i = 1, #data do
			local d = data[i]
			if #d.hidden > 0 then
				if #d.hidden == d.eVal then
					for _i = 1, #d.hidden do
						local n = d.hidden[_i]
						if n.Color ~= _Color3(0,0,0) then
							mineQueue[#mineQueue + 1] = n; madeDeduction = true
						end
					end
				elseif d.eVal <= 0 then
					for _i = 1, #d.hidden do
						local n = d.hidden[_i]
						if (not n or not n.Parent) then
							
						elseif n.Transparency > 0.5 or (n.Color.R > 0.7 and n.Color.G > 0.7 and n.Color.B < 0.6) or n:FindFirstChild("NumberGui") then
							
						elseif n.Color ~= _Color3(0,0,0) then
							safeQueue[#safeQueue + 1] = n; madeDeduction = true
						end
					end
				end
			end
		end
		if not madeDeduction then
			local bfSafe, bfMines, bfProbs = bruteForceSolve(data)
			if bfProbs then bfProbCache = bfProbs end
			if bfSafe then
				for _i = 1, #bfSafe do
					local s = bfSafe[_i]
					if (not s or not s.Parent) then
						
					elseif s.Transparency > 0.5 or (s.Color.R > 0.7 and s.Color.G > 0.7 and s.Color.B < 0.6) or s:FindFirstChild("NumberGui") then
						
					elseif s.Color ~= _Color3(0,0,0) then
						safeQueue[#safeQueue + 1] = s; madeDeduction = true
					end
				end
			end
			if bfMines then
				for _i = 1, #bfMines do
					local m = bfMines[_i]
					if m.Color ~= _Color3(0,0,0) then
						mineQueue[#mineQueue + 1] = m; madeDeduction = true
					end
				end
			end
		end
		if not madeDeduction then break end
		for _i = 1, #mineQueue do
			local m = mineQueue[_i]
			m.Color = _Color3(0, 0, 0)
			if solvAutoFlag and currentTab == "solver" and isAutoSolving then
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root and (m.Position - root.Position).Magnitude <= flagRange and not isAlreadyFlagged(m) then
					local cd = m:FindFirstChildOfClass("ClickDetector")
					if cd and (not flaggedDebounce[m] or _clock() - flaggedDebounce[m] > 1) then
						fireclickdetector(cd); flaggedDebounce[m] = _clock()
					end
				end
			end
			allMines[#allMines + 1] = m
		end
		for _i = 1, #safeQueue do
			local s = safeQueue[_i]
			if currentTab ~= "solver" then s.Color = _Color3(1, 1, 1) end
			allSafe[#allSafe + 1] = s
		end
		bfProbCache = nil
		data, cellToData = getSolverData()
		if #data == 0 then break end
	end
	if not bfProbCache and currentTab == "solver" and isAutoSolving then
		local _, _, probs = bruteForceSolve(data)
		if probs then bfProbCache = probs end
	end
	if currentTab == "solver" and isAutoSolving then
		if #allSafe > 0 then
			isGuessing = false
			_tsort(allSafe, function(a, b)
				local na, nb = 0, 0
				local naList = neighborCache[a]
				if naList then for _i = 1, #naList do local n = naList[_i]; if (not n or not n.Parent) then elseif n.Transparency > 0.5 or (n.Color.R > 0.7 and n.Color.G > 0.7 and n.Color.B < 0.6) or n:FindFirstChild("NumberGui") then else na = na + 1 end end end
				local nbList = neighborCache[b]
				if nbList then for _i = 1, #nbList do local n = nbList[_i]; if (not n or not n.Parent) then elseif n.Transparency > 0.5 or (n.Color.R > 0.7 and n.Color.G > 0.7 and n.Color.B < 0.6) or n:FindFirstChild("NumberGui") then else nb = nb + 1 end end end
				return na > nb
			end)
			for _i = 1, #allSafe do
				local s = allSafe[_i]
				if stopCurrentExecution or not isAutoSolving then break end
				if (not s or not s.Parent) then
					
				elseif s.Transparency > 0.5 or (s.Color.R > 0.7 and s.Color.G > 0.7 and s.Color.B < 0.6) or s:FindFirstChild("NumberGui") then
					
				else
					teleportTo(s); _wait(actionDelay)
				end
			end
		elseif autoGuess and _clock() - lastActionTime > 0.8 then
			local candidates = {}
			local cascadeCache = {}
			for _i = 1, #data do
				local d = data[_i]
				local hlist = d.hidden
				for _j = 1, #hlist do
					local h = hlist[_j]
					if not cascadeCache[h] and h.Color ~= _Color3(0,0,0) then
						cascadeCache[h] = estimateCascade(h, cellToData, data)
					end
				end
			end
			local totalHidden, constraintMines = 0, 0
			for _i = 1, #data do
				local d = data[_i]
				totalHidden = totalHidden + #d.hidden
				constraintMines = constraintMines + d.eVal
			end
			local remainingMines = constraintMines
			local globalSurvival = (totalHidden > 0) and ((totalHidden - remainingMines) / totalHidden) or 0.01
			local folder = workspace:FindFirstChild("Flag") and workspace.Flag:FindFirstChild("Parts")
			local openCount = 0
			if folder then
				local folderChildren = folder:GetChildren()
				for _i = 1, #folderChildren do
					local p = folderChildren[_i]
					if (not p or not p.Parent) then
						
					elseif p.Transparency > 0.5 or (p.Color.R > 0.7 and p.Color.G > 0.7 and p.Color.B < 0.6) or p:FindFirstChild("NumberGui") then
						openCount = openCount + 1
					end
				end
			end
			local isFirstMove = openCount <= 1
			if isFirstMove then
				local allCells = {}
				for _i = 1, #data do
					local d = data[_i]
					local hlist = d.hidden
					for _j = 1, #hlist do
						local h = hlist[_j]
						if h.Color ~= _Color3(0,0,0) then allCells[h] = true end
					end
				end
				local minX, maxX, minZ, maxZ = _mhuge, -_mhuge, _mhuge, -_mhuge
				local k = _next(allCells, nil)
				while k do
					if k.Position.X < minX then minX = k.Position.X end
					if k.Position.X > maxX then maxX = k.Position.X end
					if k.Position.Z < minZ then minZ = k.Position.Z end
					if k.Position.Z > maxZ then maxZ = k.Position.Z end
					k = _next(allCells, k)
				end
				local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
				local bestScore, bestCell = -_mhuge
				local k = _next(allCells, nil)
				while k do
					local nbs = neighborCache[k]
					local nc = nbs and #nbs or 0
					local dist = (k.Position - _Vector3(cx, 0, cz)).Magnitude
					local score = nc * 10 - dist
					if score > bestScore then bestScore = score; bestCell = k end
					k = _next(allCells, k)
				end
				if bestCell then
					isGuessing = true; teleportTo(bestCell); lastActionTime = _clock()
					return
				end
			end
			if bfProbCache then
				local bestEV = -_mhuge
				local k = _next(bfProbCache, nil)
				while k do
					local prob = bfProbCache[k]
					if (k and k.Parent) then
						local isOpen = k.Transparency > 0.5 or (k.Color.R > 0.7 and k.Color.G > 0.7 and k.Color.B < 0.6) or k:FindFirstChild("NumberGui")
						if not isOpen and k.Color ~= _Color3(0,0,0) then
							local ev = (1 - prob) * (cascadeCache[k] or 1) * globalSurvival
							if ev > bestEV then bestEV = ev; candidates = {k}
							elseif ev == bestEV then candidates[#candidates + 1] = k end
						end
					end
					k = _next(bfProbCache, k)
				end
				if #candidates == 0 then
					local anyLeft
					local k = _next(bfProbCache, nil)
					while k do
						if (k and k.Parent) then
							local isOpen = k.Transparency > 0.5 or (k.Color.R > 0.7 and k.Color.G > 0.7 and k.Color.B < 0.6) or k:FindFirstChild("NumberGui")
							if not isOpen and k.Color ~= _Color3(0,0,0) then anyLeft = true; break end
						end
						k = _next(bfProbCache, k)
					end
					if not anyLeft then
						chatNotify("board complete")
						isAutoSolving = false; refreshStatusUI()
						return
					end
				end
			end
			if #candidates == 0 then
				local seen = {}
				local k = _next(cascadeCache, nil)
				while k do
					seen[k] = true
					k = _next(cascadeCache, k)
				end
				if folder then
					local folderChildren = folder:GetChildren()
					for _i = 1, #folderChildren do
						local p = folderChildren[_i]
						if (not p or not p.Parent) then
							
						elseif p.Transparency > 0.5 or (p.Color.R > 0.7 and p.Color.G > 0.7 and p.Color.B < 0.6) or p:FindFirstChild("NumberGui") then
							
						elseif p.Color ~= _Color3(0,0,0) and not seen[p] then
							local prob = (remainingMines / math.max(totalHidden, 1))
							local ev = (1 - prob) * math.max(estimateCascade(p, cellToData, data), 1) * globalSurvival
							cascadeCache[p] = ev
							candidates[#candidates + 1] = p
						end
					end
				end
				if #candidates == 0 then
					local bestCascade = -1
					local k = _next(cascadeCache, nil)
					while k do
						local c = cascadeCache[k]
						if (k and k.Parent) then
							local isOpen = k.Transparency > 0.5 or (k.Color.R > 0.7 and k.Color.G > 0.7 and k.Color.B < 0.6) or k:FindFirstChild("NumberGui")
							if not isOpen and k.Color ~= _Color3(0,0,0) then
								if c > bestCascade then bestCascade = c; candidates = {k}
								elseif c == bestCascade then candidates[#candidates + 1] = k end
							end
						end
						k = _next(cascadeCache, k)
					end
				end
			end
			if #candidates > 1 then
				_tsort(candidates, function(a, b) return (cascadeCache[a] or 0) > (cascadeCache[b] or 0) end)
			end
			if #candidates > 0 then
				isGuessing = true; teleportTo(candidates[1]); lastActionTime = _clock()
			end
		end
	elseif currentTab == "flag" and isLegitActive then
		local flagCount = 0
		for _i = 1, #allMines do
			local m = allMines[_i]
			if flagCount >= 3 then break end
			if not autoFlagEnabled then break end
			if flaggedDebounce[m] and _clock() - flaggedDebounce[m] <= 1 then continue end
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and (m.Position - root.Position).Magnitude <= flagRange and not isAlreadyFlagged(m) then
				local cd = m:FindFirstChildOfClass("ClickDetector")
				if cd then fireclickdetector(cd); flaggedDebounce[m] = _clock(); flagCount = flagCount + 1 end
			end
		end
		if chordEnabled then
			for _i = 1, #data do
				local d = data[_i]
				if d.eVal == 0 and #d.hidden > 0 then
					local cd = d.obj:FindFirstChildOfClass("ClickDetector")
					if cd and (not flaggedDebounce[d.obj] or _clock() - flaggedDebounce[d.obj] > 2) then
						fireclickdetector(cd); flaggedDebounce[d.obj] = _clock()
					end
				end
			end
		end
	end
end
