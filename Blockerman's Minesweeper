	if curVersion ~= gridVersion then
		gridVersion = curVersion
		neighborCache = {}
		spatialPosMap = nil
		gridSpacingX, gridSpacingZ = nil, nil
		if curVersion >= 2 then detectGridSpacing(allParts) end
	end
	local numberData, cellToData = {}, {}
	for i = 1, #allParts do
		local cell = allParts[i]
