end)
task.spawn(function()
	while true do
		_wait(autoFlagDelay)
		if not autoFlag then continue end
		local board = getBoard()
		if not board or not hasMineData(board) then continue end
		local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		local candidates = {}
		for _, tile in board:GetChildren() do
			if tile:GetAttribute("Tile") and isTileMine(tile) and not isTileFlagged(tile) then
				local dist = ((tile.Position - root.Position) * _Vector3(1, 0, 1)).Magnitude
				if dist <= autoFlagRange then
					candidates[#candidates + 1] = {tile = tile, dist = dist}
				end
			end
		end
		if #candidates > 0 then
			table.sort(candidates, function(a, b) return a.dist < b.dist end)
			local target = candidates[1].tile
			flagTile(target)
		end
	end
end)
